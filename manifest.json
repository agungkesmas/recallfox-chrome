{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "RecallFox",
  "version": "3.21.22",
  "description": "__MSG_extDesc__",
  "author": "RecallFox",
  "homepage_url": "https://github.com/agungkesmas/recallfox",
  "default_locale": "id",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.svg"
  },
  "permissions": [
    "storage",
    "menus",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "downloads",
    "unlimitedStorage",
    "browsingData",
    "notifications",
    "geolocation",
    "alarms",
    "identity"
  ],
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "<all_urls>",
    "https://api.aladhan.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://chat.z.ai/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://tongyi.aliyun.com/*",
    "https://chat.qwen.ai/*",
    "https://kimi.moonshot.cn/*",
    "https://kimi.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://api.z.ai/*",
    "https://api.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://www.googleapis.com/*",
    "https://qmwofsfpxjptpyvncylp.supabase.co/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg"
    },
    "default_title": "RecallFox",
    "default_popup": "popup/popup.html"
  },
  "sidebar_action": {
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg"
    },
    "default_title": "RecallFox Vault",
    "default_panel": "sidebar/sidebar.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/ai-resolvers.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/overlay.js",
        "content/selection-ai.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/volume-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/volume-shared.js",
        "content/volume-cs.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*",
        "https://*.youtubekids.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "content/contentguard-cs.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/elementblocker-cs.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/tape-cs.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/notes-cs.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content/sidebar-cs.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/capture.css",
        "content/overlay.css",
        "contentguard/takeover.html",
        "contentguard/takeover.css",
        "contentguard/takeover.js",
        "contentguard/blocked.html",
        "contentguard/blocked.css",
        "contentguard/blocked.js",
        "contentguard/searchlock.html",
        "contentguard/searchlock.css",
        "contentguard/searchlock.js",
        "popup/viewer.html",
        "popup/viewer.js",
        "popup/viewer.css",
        "lib/tape.js",
        "lib/notes.js",
        "lib/pomodoro.js",
        "lib/float-sync.js",
        "lib/todoist-parse.js",
        "assets/sounds/adzan-mekkah-30s.mp3",
        "assets/sounds/adzan-madinah-30s.mp3",
        "assets/sounds/adzan-istanbul-30s.mp3",
        "assets/sounds/bell-soft.mp3",
        "assets/sounds/bell-classic.mp3",
        "assets/sounds/bell-digital.mp3",
        "lib/ai-detect.js",
        "lib/vault-tree.js",
        "sidebar/sidebar.html",
        "sidebar/sidebar.css",
        "sidebar/sidebar.js",
        "popup/popup.css",
        "popup/popup.js",
        "popup/popup.html",
        "settings/settings.html",
        "settings/settings.css",
        "settings/settings.js",
        "lib/browser-polyfill.min.js",
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-96.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "recallfox@example.com",
      "strict_min_version": "115.0"
    }
  }
}
